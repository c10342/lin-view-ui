{
  "name": "z-ui",
  "version": "1.0.0",
  "main": "dist/lib/index.js",
  "module": "dist/es/index.mjs",
  "types": "dist/es/index.d.ts",
  "style": "dist/theme-chalk/index.css",
  "exports": {
    ".": {
      "types": "./dist/es/index.d.ts",
      "import": "./dist/es/index.mjs",
      "require": "./dist/lib/index.js"
    },
    "./global": {
      "types": "./global.d.ts"
    },
    "./plugins": {
      "types": "./plugins/index.d.ts",
      "import": "./plugins/index.mjs"
    },
    "./es": {
      "types": "./dist/es/index.d.ts",
      "import": "./dist/es/index.mjs"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "require": "./dist/lib/index.js"
    },
    "./es/*.mjs": {
      "types": "./dist/es/*.d.ts",
      "import": "./dist/es/*.mjs"
    },
    "./es/*": {
      "types": [
        "./dist/es/*.d.ts",
        "./dist/es/*/index.d.ts"
      ],
      "import": "./dist/es/*.mjs"
    },
    "./lib/*.js": {
      "types": "./dist/lib/*.d.ts",
      "require": "./dist/lib/*.js"
    },
    "./lib/*": {
      "types": [
        "./dist/lib/*.d.ts",
        "./dist/lib/*/index.d.ts"
      ],
      "require": "./dist/lib/*.js"
    },
    "./*": "./*"
  },
  "scripts": {
    "dev": "vite --config ./play/vite.config.ts",
    "build:component": "rimraf dist && vite build --config ./scripts/build.ts",
    "build:css": "rimraf dist/theme-chalk && node ./scripts/css.js",
    "build": "npm run build:component && npm run build:css",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "lint-staged": "lint-staged --config lint-staged.config.js",
    "commitlint": "commitlint --config commitlint.config.js -e -V",
    "commit": "git cz",
    "lint": "eslint --ext .js,.vue,.jsx,.ts,.tsx ./",
    "lint-fix": "eslint --fix --ext .js,.vue,.jsx,.ts,.tsx ./",
    "lint:style": "stylelint **/*.{css,scss}",
    "lint:style-fix": "stylelint **/*.{css,scss} --fix",
    "test": "vitest --config ./scripts/vitest.config.ts",
    "coverage": "vitest run --coverage  --config ./scripts/vitest.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@commitlint/cli": "19.3.0",
    "@commitlint/config-conventional": "19.2.2",
    "@types/node": "22.10.5",
    "@typescript-eslint/eslint-plugin": "8.20.0",
    "@typescript-eslint/parser": "8.20.0",
    "@vitejs/plugin-vue": "5.2.1",
    "@vitejs/plugin-vue-jsx": "4.1.1",
    "@vitepress-demo-preview/component": "2.3.2",
    "@vitepress-demo-preview/plugin": "1.2.3",
    "@vitest/coverage-v8": "^3.0.3",
    "@vue/test-utils": "^2.4.6",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "8.57.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-define-config": "2.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "eslint-plugin-vue": "9.27.0",
    "gulp": "5.0.0",
    "gulp-autoprefixer": "8.0.0",
    "gulp-clean-css": "4.3.0",
    "gulp-sass": "6.0.0",
    "husky": "9.0.11",
    "jsdom": "26.0.0",
    "lint-staged": "15.2.7",
    "prettier": "3.3.2",
    "rimraf": "6.0.1",
    "sass-embedded": "1.83.1",
    "stylelint": "16.6.1",
    "stylelint-config-recess-order": "5.0.1",
    "stylelint-config-recommended-scss": "14.0.0",
    "stylelint-config-standard": "36.0.1",
    "stylelint-order": "6.0.4",
    "stylelint-scss": "6.3.2",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vite-plugin-dts": "4.5.0",
    "vitepress": "1.5.0",
    "vitest": "3.0.3",
    "vue": "3.5.13",
    "vue-eslint-parser": "9.4.3",
    "vue-router": "4.5.0"
  },
  "peerDependencies": {
    "vue": ">=3.5.13"
  },
  "dependencies": {
    "@ricons/ionicons5": "0.13.0"
  }
}
